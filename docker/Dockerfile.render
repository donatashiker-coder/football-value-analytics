# Single-container image for Render (and any host that runs one web process):
# builds the React frontend, then serves it from the FastAPI backend (frontend/dist is picked up by app/main.py).
FROM node:20-alpine AS frontend
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend .
RUN npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install -r /app/backend/requirements.txt

COPY backend /app/backend
COPY migrations /app/migrations
COPY scripts /app/scripts
COPY --from=frontend /app/dist /app/frontend/dist

WORKDIR /app/backend
RUN useradd -m fva && mkdir -p /app/data/cache && chown -R fva:fva /app
USER fva

EXPOSE 8000
CMD ["sh", "/app/scripts/start-backend.sh"]
