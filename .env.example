# ============================================================
# FOOTBALL VALUE ANALYTICS — environment configuration
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- Application ---
APP_ENV=development            # development | production | test
APP_MODE=demo                  # demo | production   (demo = synthetic, clearly-labelled data, no keys needed)
LOG_LEVEL=INFO
SECRET_KEY=change-me
TIMEZONE=Europe/London
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database / cache ---
# Docker compose default:
DATABASE_URL=postgresql+psycopg://fva:fva@postgres:5432/fva
# Local dev without Docker (SQLite is supported for development/tests):
# DATABASE_URL=sqlite:///./data/fva.db
REDIS_URL=redis://redis:6379/0

# --- Football data providers (production mode) ---
# Primary fixtures/results provider: football-data.org  (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=
# Rich statistics provider (corners, shots, injuries, odds): API-Football (https://www.api-football.com/)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Which provider supplies fixtures/results: football_data | api_football
FOOTBALL_PROVIDER=api_football

# --- Odds providers ---
# The Odds API (https://the-odds-api.com/)
ODDS_API_KEY=
ODDS_PROVIDER=the_odds_api      # the_odds_api | api_football

# --- Optional providers ---
NEWS_API_KEY=
WEATHER_API_KEY=                # Open-Meteo needs no key; leave blank to use it
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=none               # none | anthropic | openai
LLM_MODEL=claude-sonnet-5

# --- Scheduler (24h, Europe/London) ---
SCHEDULER_ENABLED=true
SCHEDULE_UPDATE_FIXTURES=06:00
SCHEDULE_UPDATE_STATS=06:15
SCHEDULE_UPDATE_NEWS=06:30
SCHEDULE_UPDATE_ODDS=06:45
SCHEDULE_RUN_MODELS=07:00
SCHEDULE_REPORT=07:05
ODDS_REFRESH_MINUTES=120

# --- Notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
